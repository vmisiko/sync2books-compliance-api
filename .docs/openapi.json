            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "required": false,
            "in": "query",
            "description": "Filter by code prefix or name (case-insensitive contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeInactive",
            "required": false,
            "in": "query",
            "description": "Include codes where useYn=N (retired). Defaults to false.",
