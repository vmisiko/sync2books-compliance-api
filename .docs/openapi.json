    "/catalog/item-classifications": {
      "get": {
        "operationId": "CatalogController_searchItemClassifications",
        "parameters": [
          {
            "name": "query",
            "required": false,
            "in": "query",
            "description": "Filter by item classification code prefix or name (case-insensitive contains)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "itemClsLvl",
            "required": false,
            "in": "query",
            "description": "Filter by classification level (1-5)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeInactive",
            "required": false,
            "in": "query",
            "description": "Include codes where useYn=N (retired). Defaults to false.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Max rows to return (default 20, max 100)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching classification codes"
          }
        },
        "summary": "Search OSCU item classification codes (itemClsCd) for use when registering items",
        "tags": [
          "Catalog"
        ]
      }
    },
    "/catalog/item-classifications/{itemClsCd}": {
      "get": {
        "operationId": "CatalogController_getItemClassification",
